# Where "Landing" in the nav points while developing.
#
# apps/landing runs on port 5175. Without this the link resolves to "/", which on
# the dev server is this app itself - a link that appears to do nothing.
#
# Committed on purpose: it holds no secret, and the alternative is every developer
# rediscovering the port.
VITE_LANDING_URL="http://localhost:5175/"
