{
  "name": "arbiter",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "test": "vitest run",
    "lint": "eslint packages apps services --ext .ts,.tsx",
    "typecheck": "tsc -b packages/engine apps/harness && tsc -p apps/deliberation --noEmit && tsc -p packages/design --noEmit && tsc -p packages/atmosphere --noEmit && tsc -p apps/landing --noEmit && tsc -p apps/atmosphere --noEmit && tsc -p services/api --noEmit",
    "harness": "tsx apps/harness/src/main.ts",
    "validate:evidence": "tsx apps/harness/src/validate-evidence.ts",
    "metrics": "tsx apps/harness/src/run-metrics.ts",
    "coverage:report": "tsx apps/harness/src/coverage-report.ts",
    "golden:update": "tsx apps/harness/src/update-golden.ts",
    "e2e": "playwright test",
    "dev": "node tools/dev-all.mjs",
    "probe:case": "python tools/build_probe_case.py",
    "probe": "tsx services/api/probe.ts",
    "probe:report": "tsx apps/harness/src/consistency-report.ts",
    "retrieval:eval": "tsx services/api/retrieval-eval.ts",
    "ask:eval": "tsx services/api/ask-eval.ts",
    "report": "tsx services/api/report.ts",
    "deliberate:demo": "tsx services/api/deliberation-demo.ts",
    "api": "tsx services/api/server.ts",
    "seed:demo": "tsx services/api/seed-demo.ts",
    "seed:documents": "node tools/seed-demo-documents.mjs",
    "library:fetch": "node tools/fetch-library.mjs",
    "check:deps": "node tools/check-deps.mjs",
    "deliberate:dev": "node tools/check-deps.mjs && npm run dev -w @arbiter/deliberation",
    "deliberate:build": "npm run build -w @arbiter/deliberation",
    "landing:dev": "npm run dev -w @arbiter/landing",
    "landing:build": "npm run build -w @arbiter/landing",
    "site:build": "npm run deliberate:build && npm run landing:build && node tools/stage-site.mjs",
    "verdict:eval": "tsx services/api/verdict-eval.ts",
    "verdict:real": "tsx services/api/verdict-real-eval.ts",
    "verdict:counterfactual": "tsx services/api/counterfactual-eval.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.12.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.185.4",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^8.57.0",
    "gsap": "^3.15.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "google-auth-library": "^11.0.1"
  }
}
